# OpenRouter API Key for AI-powered cash flow predictions
# Get your API key from https://openrouter.ai
REACT_APP_OPENROUTER_API_KEY=sk-or-your-api-key-here

# Example:
# REACT_APP_OPENROUTER_API_KEY=sk-or-v1-1234567890abcdef1234567890abcdef1234567890abcdef1234567890abcdef

# To test AI integration:
# 1. Get API key from https://openrouter.ai
# 2. Replace 'sk-or-your-api-key-here' with your real key
# 3. Create .env file with: REACT_APP_OPENROUTER_API_KEY=your-real-key
# 4. Enable "AI Predictions" checkbox in dashboard
# 5. Check browser console for AI activity logs
