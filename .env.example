NODE_ENV=development
PORT=3001
PUBLIC_APP_URL=http://127.0.0.1:3001
LEDGER_DATABASE_PATH=data/cash-flow.sqlite
AUTO_MIGRATE=true

# Generate four different random values of at least 32 characters. Never reuse them.
OPERATOR_API_TOKEN=
AUDITOR_API_TOKEN=
PROVIDER_WEBHOOK_SECRET=
IDENTITY_HASH_SECRET=

# Comma-separated provider IDs backed by signed license/data contracts.
LICENSED_PROVIDERS=

# Live execution is intentionally unavailable and startup rejects true.
LIVE_TRADING_ENABLED=false

# Used only by the explicit one-time `npm run admin:bootstrap` command.
BOOTSTRAP_EMAIL=
BOOTSTRAP_PASSWORD=
BOOTSTRAP_ROLE=operator
# Local-only demo autofill. The ignored .env must provide one complete
# DEMO_*, SEED_ADMIN_*, ADMIN_*, or DEFAULT_* email/password pair.
ENABLE_DEMO_CREDENTIAL_AUTOFILL=false
