{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist-server",
    "rootDir": ".",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": ["server.ts", "src/server/**/*.ts", "scripts/migrate.ts", "scripts/bootstrap-user.ts"],
  "exclude": ["node_modules", "dist-web", "tests"]
}
