{
  "name": "cash-flow-manager",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev:web": "vite --host 127.0.0.1",
    "dev:server": "tsx watch server.ts",
    "build:web": "vite build",
    "build:server": "tsc --project tsconfig.server.json",
    "build": "npm run build:web && npm run build:server",
    "start": "node dist-server/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint server.ts src/server scripts tests vite.config.ts --max-warnings=0",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration --no-file-parallelism",
    "test:e2e": "playwright test",
    "db:migrate": "tsx scripts/migrate.ts",
    "admin:bootstrap": "tsx scripts/bootstrap-user.ts",
    "security:audit": "npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "chart.js": "^4.5.1",
    "date-fns": "^4.4.0",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.0",
    "helmet": "^8.3.0",
    "lucide-react": "^1.25.0",
    "papaparse": "^5.5.4",
    "react": "^19.2.7",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.2.7",
    "react-helmet-async": "^3.0.0",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/express": "^5.0.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.10.0",
    "@types/papaparse": "^5.3.16",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.4.24",
    "eslint": "^9.39.1",
    "postcss": "^8.5.6",
    "supertest": "^7.2.2",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
